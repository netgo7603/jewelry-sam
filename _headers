# Cloudflare Pages HTTP Headers - Optimized Cache Strategy
# HTML, JS, CSS: No cache (prevent stale content after deployments)
# Images: Cache for 7 days (static assets rarely change)

/*.html
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

/*.js
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

/*.css
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

/images/*
  Cache-Control: public, max-age=604800
  Access-Control-Allow-Origin: *

/*.xml
  Cache-Control: no-cache, max-age=3600

/*.json
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Access-Control-Allow-Origin: *

/*
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
